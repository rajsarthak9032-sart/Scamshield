# Base URL of the optional secure analysis backend.
#
# Leave this EMPTY for the free version: ScamShield will run entirely in the browser
# using its built-in rule-based Pattern Engine (no backend, no token, fully static).
#
# Set this ONLY when you add a secure backend (e.g. Netlify Function -> Qwen3-30B):
#   VITE_SCAMSHIELD_API_URL=https://your-backend.example.com/analyze
#
# IMPORTANT: never put an HF_TOKEN here. The browser must never hold a token.
VITE_SCAMSHIELD_API_URL=
